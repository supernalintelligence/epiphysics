    {
      "id": "doc_graph_transforms_run",
      "kind": "document",
      "title": "Reviewed fixed graph-operation execution record",
      "repo_path": "docs/planning/runs/2026-11-25-graph-transforms.md"
    },
    {
      "id": "claim_fixed_graph_conformance",
      "kind": "claim",
      "title": "Recorded fixed graph-operation conformance",
      "statement": "The committed B2a run record documents local independent review and 26/26 synthetic API checks under graph-transformation-probes-v2. The fixed identity/projection implementation computes outputs and losses and rejects altered completion inputs. This is bounded local conformance, not arbitrary artifact execution, semantic equivalence, external witnessing or predictive advantage.",
      "status": "implementation_finding",
      "basis": "observed"
    },
    {
      "id": "claim_graph_output_scope",
      "kind": "claim",
      "title": "Embedded outputs and assessment costs have limited scope",
      "statement": "The B2a run record embeds generated graphs in completion events without materializing new representation or forecast manifests. Its elapsed time and zero program model calls/external spend cover assessment, not the full builder and reviewer effort. The retained record does not close either the output-consumer or whole-step cost gap.",
      "status": "implementation_finding",
      "basis": "observed"
    },
    {
      "id": "claim_source_assertions_conformance",
      "kind": "claim",
      "title": "Recorded assertion API conformance",
      "statement": "The committed A run record documents independent local review and a real assessment worker with 8/8 source-span and 6/6 assertion-history checks on synthetic ledgers. These are implementation contracts, not extraction truth, predictive improvement, deployment or independent timestamp assurance.",
      "status": "implementation_finding",
      "basis": "observed"
    },
    {
      "id": "claim_manifest_binding_conformance",
      "kind": "claim",
      "title": "Recorded manifest and forecast-binding conformance",
      "statement": "The committed B1 run record documents independent local review and 22/22 actual manifest API checks under representation-manifest-probes-v2, including identity, input and supplied-forecast binding. The recorded worker queued transformations; this does not prove predictor execution, independently measured costs, transformation preservation or predictive advantage.",
      "status": "implementation_finding",
      "basis": "observed"
    },
    {
      "id": "claim_meta",
      "kind": "claim",
      "title": "Operational meta-representation",
      "statement": "A meta-representation records representation families, permitted transformations, preservation obligations and comparative evidence.",
      "status": "definition",
      "basis": "inferred"
    },
    {
      "id": "claim_entities",
      "kind": "claim",
      "title": "Entityhood is representability",
      "statement": "The project convention defines an entity as anything representable, with persistence treated separately.",
      "status": "definition",
      "basis": "reported"
    },
    {
      "id": "claim_fixed_entities",
      "kind": "claim",
      "title": "Entityhood as persistent fixed points",
      "statement": "The Lawvere note associates entities with persistent fixed points; this conflicts with the broader project convention.",
      "status": "contested",
      "basis": "reported"
    },
    {
      "id": "claim_lawvere_limit",
      "kind": "claim",
      "title": "Fixed-point hypotheses are required",
      "statement": "Lawvere fixed-point results do not establish dynamic attraction, conservation or mechanical structure without additional construction.",
      "status": "reported_result",
      "basis": "reported"
    },
    {
      "id": "claim_prompt_mechanics",
      "kind": "claim",
      "title": "Prompt as Lagrangian",
      "statement": "A correspondence between prompt revision and Lagrangian dynamics is a hypothesis requiring operational variables and discriminating tests.",
      "status": "hypothesis",
      "basis": "inferred"
    },
    {
      "id": "claim_derivation",
      "kind": "claim",
      "title": "Construction of variables remains open",
      "statement": "The project has not derived a general procedure for choosing optimal state variables from observations.",
      "status": "implementation_finding",
      "basis": "reported"
    },
    {
      "id": "claim_ledger",
      "kind": "claim",
      "title": "Ledger preserves attributed representations",
      "statement": "The integrated ledger preserves directed typed relationships with evidence scoped to a selected snapshot.",
      "status": "implementation_finding",
      "basis": "observed"
    },
    {
      "id": "claim_story",
      "kind": "claim",
      "title": "Story parser is a mutable view",
      "statement": "The story parser uses names as relationship endpoints and time-dependent identifiers rather than an immutable assertion history.",
      "status": "implementation_finding",
      "basis": "observed"
    },
    {
      "id": "claim_temporal",
      "kind": "claim",
      "title": "Two time axes are necessary",
      "statement": "World-time claims and collection-time eligibility must remain separate to prevent retrospective knowledge leakage.",
      "status": "definition",
      "basis": "inferred"
    },
    {
      "id": "claim_newer",
      "kind": "claim",
      "title": "Newer information is not automatically true",
      "statement": "Preserve disagreement and corrections separately instead of making recency the scientific truth policy.",
      "status": "definition",
      "basis": "inferred"
    },
    {
      "id": "claim_graph_task",
      "kind": "claim",
      "title": "Graph usefulness depends on task and budget",
      "statement": "Graph retrieval should be compared with strong text retrieval at matched context and total construction costs.",
      "status": "hypothesis",
      "basis": "inferred"
    },
    {
      "id": "claim_memory_eval",
      "kind": "claim",
      "title": "Memory requires multiple tests",
      "statement": "Temporal reasoning, updates, abstention, environment experience and heterogeneous evidence require distinct evaluation tasks.",
      "status": "reported_result",
      "basis": "reported"
    },
    {
      "id": "claim_graphiti",
      "kind": "claim",
      "title": "Graphiti is a candidate adapter",
      "statement": "Temporal graph and hybrid retrieval functionality can be evaluated behind an adapter while independent source history is retained.",
      "status": "hypothesis",
      "basis": "inferred"
    },
    {
      "id": "claim_interchange",
      "kind": "claim",
      "title": "Standards describe structure and provenance",
      "statement": "RDF, PROV-O, SHACL and nanopublications offer complementary interchange, provenance, validation and assertion packaging.",
      "status": "reported_result",
      "basis": "reported"
    },
    {
      "id": "claim_mdl",
      "kind": "claim",
      "title": "Selection must charge the interpreter",
      "statement": "Description-length comparison requires explicit coding and residual conventions, rather than measuring prompt length alone.",
      "status": "hypothesis",
      "basis": "inferred"
    },
    {
      "id": "claim_program",
      "kind": "claim",
      "title": "Reusable programs can change representation vocabulary",
      "statement": "Library learning is a concrete candidate mechanism for expanding the primitives used to express solutions.",
      "status": "hypothesis",
      "basis": "inferred"
    },
    {
      "id": "claim_typed",
      "kind": "claim",
      "title": "Transformations need preservation contracts",
      "statement": "Type or semantic obligations can make schema migration accountable; canonical mappings need not be invertible.",
      "status": "hypothesis",
      "basis": "inferred"
    },
    {
      "id": "claim_causal",
      "kind": "claim",
      "title": "Causal identification is conditional",
      "statement": "Unsupervised disentanglement is not generally identifiable; interventions can help under specified assumptions.",
      "status": "reported_result",
      "basis": "reported"
    },
    {
      "id": "claim_abstraction",
      "kind": "claim",
      "title": "Causal abstraction concerns interventions",
      "statement": "Candidate scale changes should be tested for agreement on declared intervention predictions.",
      "status": "hypothesis",
      "basis": "inferred"
    },
    {
      "id": "claim_reflection",
      "kind": "claim",
      "title": "Reflection must face new evaluation",
      "statement": "Trace-based candidate search is promising but final evaluation must remain separate from adaptive selection.",
      "status": "hypothesis",
      "basis": "inferred"
    },
    {
      "id": "claim_selfproof",
      "kind": "claim",
      "title": "Self-improvement guarantees are conditional",
      "statement": "Formal self-rewrite and incompleteness results do not imply a practical universally improving research agent.",
      "status": "reported_result",
      "basis": "reported"
    },
    {
      "id": "claim_concentration",
      "kind": "claim",
      "title": "Capability can reinforce control",
      "statement": "Capability gains may increase resources and access rights, which may support further capability growth.",
      "status": "hypothesis",
      "basis": "inferred"
    },
    {
      "id": "claim_portability",
      "kind": "claim",
      "title": "Portability can distribute control",
      "statement": "Substitutable providers and portable representations may reduce dependence and concentrated veto rights.",
      "status": "hypothesis",
      "basis": "inferred"
    },
    {
      "id": "claim_feedback",
      "kind": "claim",
      "title": "Actions change prediction targets",
      "statement": "Using forecasts to select actions can alter the distribution of subsequent outcomes.",
      "status": "reported_result",
      "basis": "reported"
    },
    {
      "id": "claim_exchange",
      "kind": "claim",
      "title": "Exchange must separate delivery and settlement",
      "statement": "Offer order, latency, service quality, payment and reputation should be represented and evaluated separately.",
      "status": "hypothesis",
      "basis": "inferred"
    },
    {
      "id": "claim_witness",
      "kind": "claim",
      "title": "Existence proofs do not establish truth",
      "statement": "A verified timestamp can support prior existence of committed bytes without proving their truth or availability to a model.",
      "status": "reported_result",
      "basis": "reported"
    },
